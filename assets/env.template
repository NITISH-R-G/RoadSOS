# Copy this file to assets/.env and fill in values.
# Note: this repo currently tracks a blank `assets/.env` as a safe template so CI/builds
# always have the asset present; do not commit real secrets to public repos.
# Supabase / PowerSync — from project dashboard; enable RLS on anon tables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
POWERSYNC_URL=

# Gemini triage runs server-side via Supabase Edge Function secrets (GEMINI_API_KEY).
# Mobile clients should NOT hold Gemini keys.
